  m_Script: {fileID: 11500000, guid: eb87fc7884e09a74d8a1d9d887961557, type: 3}
  m_Name: NeedTalk
  m_EditorClassIdentifier: 
  id: need_talk
  playerChoiceText: Do you need to talk about it ?
  lines:
  - speaker: Mama Nandi
    text: Then sit. No tea, but I've got ears and heart.
  - speaker: Player
    text: Everything just feels stuck. I keep trying, and nothing changes
  - speaker: Mama Nandi
    text: Mmmm... even rain takes time to fall, but it does come. And when it does,
      even dry land drinks.
  - speaker: Player
    text: "ut what if it doesn\u2019t come for me?"
  - speaker: Mama Nandi
    text: "Then you scream at the sky until it listens. You\u2019re allowed to be
      tired, child. But not to give up."
  unlockTask: {fileID: 11400000, guid: d73ee1d5c2a9d754986aeb2fc28fe387, type: 2}
