  m_Script: {fileID: 11500000, guid: eb87fc7884e09a74d8a1d9d887961557, type: 3}
  m_Name: NeedTalk
  m_EditorClassIdentifier: 
  id: need_talk
  playerChoiceText: Do you need to talk about it ?
  lines:
  - speaker: Mama Nandi
    text: Then sit. No tea, but I've got ears and heart.
  - speaker: Player
    text: Everything just feels stuck. I keep trying, and nothing changes
  - speaker: Mama Nandi
    text: Mmmm... even rain takes time to fall, but it does come. And when it does,
      even dry land drinks and also i heard that themarket supervisor needs strong
      hands for early weekend setup, a full 12-hour shift
  - speaker: Player
    text: "Twelve hours? That\u2019s brutal.."
  - speaker: Mama Nandi
    text: "It\u2019s exhausting work, back-breaking, but it pays R50 straight up"
  - speaker: Player
    text: "but I need R50, I\u2019ll be tired, but at least it\u2019s honest work
      and i also need the stability this money will bring"
  - speaker: Mama Nandi
    text: "Hard work earns respect\u2026 even more than cash.\u201D"
  - speaker: Mama Nandi
    text: Will you take this task?
  unlockTask: {fileID: 11400000, guid: 1c51858b8a3361c418e9292edc252ea8, type: 2}
