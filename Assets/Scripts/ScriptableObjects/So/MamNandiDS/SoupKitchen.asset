  m_Script: {fileID: 11500000, guid: eb87fc7884e09a74d8a1d9d887961557, type: 3}
  m_Name: SoupKitchen
  m_EditorClassIdentifier: 
  id: soup_kitchen
  playerChoiceText: 'How are things at the soup kitchen?

'
  lines:
  - speaker: Mama Nandi
    text: Busy, as always. Some days we run out of bread by noon.
  - speaker: Player
    text: That many people come for food?
  - speaker: Mama Nandi
    text: "More than I ever thought I'd see. Young ones, old ones..and by the way
      Old Man Dlamini\u2019s roof is leaking badly. If he gets sick, we all fail
      him."
  - speaker: Player
    text: "i will go check it out, I\u2019ll be sweating all day, but I can do it"
  - speaker: Mama Nandi
    text: He can only give you R30, but you will sleep well knowing he is safe.
  - speaker: Player
    text: "Knowing someone is safe\u2026 that matters more than money."
  - speaker: Mama Nandi
    text: "The work is hard, but it\u2019s honest. Are you willing?"
  unlockTask: {fileID: 11400000, guid: 969075531c6af6740acaf42917d530ac, type: 2}
