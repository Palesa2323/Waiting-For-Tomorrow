  m_Script: {fileID: 11500000, guid: eb87fc7884e09a74d8a1d9d887961557, type: 3}
  m_Name: DoThingsGetBetter
  m_EditorClassIdentifier: 
  id: things_get_better
  playerChoiceText: 'Do you think things will get better around here?  '
  lines:
  - speaker: Mama Nandi
    text: "Better? Eish\u2026 better is a long road with many potholes, my child."
  - speaker: Player
    text: But is it even worth trying then?
  - speaker: Mama Nandi
    text: "Of course it is. I\u2019ve seen people rise out of nothing. I've seen
      girls with no shoes start their own businesses. Boys become builders. It\u2019s
      hard\u2026 but it\u2019s not impossible."
  - speaker: Player
    text: You really believe that?
  - speaker: Mama Nandi
    text: "If I didn\u2019t believe, I\u2019d have stopped cooking a long time ago."
  unlockTask: {fileID: 11400000, guid: 6b5dd466b5d811140a27e2a23eff9aa7, type: 2}
