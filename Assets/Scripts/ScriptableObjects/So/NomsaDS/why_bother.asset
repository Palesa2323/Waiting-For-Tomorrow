  m_Name: why_bother
  m_EditorClassIdentifier: 
  id: 
  playerChoiceText: 'Why do you even bother? '
  lines:
  - speaker: Nomsa
    text: " Because someone has to. We can\u2019t just sit and wait forever."
  - speaker: Player
    text: " But it\u2019s exhausting, isn\u2019t it?"
  - speaker: Nomsa
    text: "Of course. But change doesn\u2019t happen when you\u2019re comfortable.
      It happens when you\u2019re tired and still stand up anyway."
  unlockTask: {fileID: 11400000, guid: a5e3544b2914244438946fdf6c5965aa, type: 2}
